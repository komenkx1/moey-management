# KeMana Environment Configuration
# 
# SECURITY NOTICE:
# - This is a template file with placeholder values
# - Copy this file to .env.local and fill in your actual credentials
# - NEVER commit .env.local to version control (it's in .gitignore)
# - .env.local contains sensitive credentials that must be kept secret
#
# Setup Instructions:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Get Supabase credentials from: https://app.supabase.com/project/_/settings/api
# 3. Get Google OAuth credentials from: https://console.cloud.google.com/apis/credentials
# 4. Get Sentry credentials from: https://sentry.io/settings/projects/
# 5. Fill in the values below in your .env.local file

# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# =============================================================================
# SENTRY CONFIGURATION
# =============================================================================
# Sentry is used for error tracking, performance monitoring, and session replay
# Get your DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/

# Required: Sentry DSN (Data Source Name) - identifies your project
NEXT_PUBLIC_SENTRY_DSN=https://abc123@example.ingest.sentry.io/1234567

# Optional: Sentry environment (defaults to NODE_ENV)
# Common values: development, staging, production
SENTRY_ENVIRONMENT=production

# Optional: Sampling rates (0.0 to 1.0)
# Error sampling - 1.0 = capture 100% of errors (recommended)
# Traces sampling - 0.1 = capture 10% of transactions for performance monitoring
SENTRY_TRACES_SAMPLE_RATE=0.1
# Session replay sampling - 0.1 = record 10% of user sessions
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
# Error replay sampling - 1.0 = record 100% of sessions that encounter errors
SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0

# Optional: Enable Sentry in development for testing (defaults to false)
# Set to "true" to send events from development environment
# MUST use NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_SENTRY_ENABLE_DEV=false

# Optional: Source maps upload configuration (for production builds)
# Get auth token from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Get org and project from your Sentry project settings URL
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Optional: Enable Sentry debug logging (defaults to false)
SENTRY_DEBUG=false

# Optional: Associate commits with releases (defaults to false)
# Requires Sentry CLI to be configured with git access
SENTRY_SET_COMMITS=true
