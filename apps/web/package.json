{
  "name": "kemana-web",
  "version": "2.0.95",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3005",
    "dev:mobile": "node scripts/print-lan-url.mjs && next dev --hostname 0.0.0.0 -p 3005",
    "dev:turbo": "next dev --turbopack --hostname 127.0.0.1 -p 3005",
    "build": "node scripts/inject-sw-version.mjs && next build",
    "build:mobile": "npm run build && npm run cap:sync-version && npx cap sync",
    "preview": "npm run build && SERVE_LAN=1 PORT=3005 node scripts/serve-static-export.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "rm -rf .next && npm run build && npx playwright test",
    "perf:ack": "node scripts/ack-perceived-benchmark.mjs",
    "perf:ack:auto": "node scripts/ack-perceived-benchmark.mjs --auto-server",
    "cap:setup": "bash scripts/capacitor-setup.sh",
    "cap:setup-assets": "bash scripts/setup-assets.sh",
    "cap:sync": "npx cap sync",
    "cap:sync:ios:dev": "CAP_APP_ID=com.kemana.app.dev CAP_APP_NAME='KeMana Dev' npx cap sync ios",
    "cap:sync:ios:beta": "CAP_APP_ID=com.kemana.app.beta CAP_APP_NAME='KeMana Beta' npx cap sync ios",
    "cap:sync-version": "bash scripts/sync-version.sh",
    "cap:check-java": "bash scripts/check-java.sh",
    "cap:fix-java": "bash scripts/fix-java-env.sh",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "bash scripts/prepare-ios-derived-data.sh && COPYFILE_DISABLE=1 npx cap run ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "ipa:ios": "bash scripts/build-ios-ipa.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/network": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@supabase/supabase-js": "^2.98.0",
    "@types/crypto-js": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.35.1",
    "lucide-react": "^0.575.0",
    "next": "15.5.12",
    "radix-ui": "^1.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^2.0.7",
    "supabase": "^2.77.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.13",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.4.24",
    "dexie": "^4.3.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.7.0",
    "playwright": "1.58.2",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.5.4",
    "vitest": "^4.0.18"
  }
}
