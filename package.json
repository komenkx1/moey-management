{
  "name": "kemana-monorepo",
  "private": true,
  "scripts": {
    "landing:dev": "npm --prefix apps/landing run dev",
    "landing:build": "npm --prefix apps/landing run build",
    "landing:start": "npm --prefix apps/landing run start",
    "security:check": "npm --prefix apps/web run security:check",
    "db:push": "npx supabase db push",
    "db:pull": "npx supabase db pull",
    "db:new": "npx supabase migration new",
    "db:status": "npx supabase db diff --schema public"
  },
  "devDependencies": {
    "supabase": "^2.77.0",
    "vitest": "^4.0.18"
  }
}
